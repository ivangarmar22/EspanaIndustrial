# España Industrial — local configuration.
# Copy to `.env.local` and fill in. Never commit real values.
# On GitHub Pages the same values come from repository variables (see docs/deployment/dominio.md).

# Public base URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Sub-path the site is served from ("/EspanaIndustrial" on github.io); empty locally and on a custom domain.
NEXT_PUBLIC_BASE_PATH=

# ── Proposals by e-mail (Colabora page) ─────────────────────
# Web3Forms access key: enter the destination address at https://web3forms.com/ and
# the key arrives by e-mail. Without it the form is replaced by a notice.
NEXT_PUBLIC_WEB3FORMS_KEY=

# ── Legal notice and privacy policy ─────────────────────────
# Name of the person responsible for the site and a contact address. Both appear
# in /aviso-legal and /privacidad (LSSI and GDPR); leave empty only in local tests.
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Donations (only configured channels are shown) ──────────
# e.g. https://paypal.me/your-name
NEXT_PUBLIC_DONATE_PAYPAL=
# e.g. https://ko-fi.com/your-name
NEXT_PUBLIC_DONATE_KOFI=
# Bizum phone number or NGO code, shown with a copy button.
NEXT_PUBLIC_DONATE_BIZUM=

# ── Data pipeline ────────────────────────────────────────────
# Contact included in the User-Agent of every outgoing request (required by
# Wikimedia's User-Agent policy). Use an address or URL where you can be reached.
DATA_CONTACT=
