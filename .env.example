# España Industrial — local configuration.
# Copy to `.env.local` and fill in. Never commit real values.

# Public base URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# ── Proposals by e-mail (Colabora page) ─────────────────────
# SMTP account that sends the proposals. With Gmail: smtp.gmail.com, port 465 and an
# app password (https://myaccount.google.com/apppasswords), never your normal password.
# If any of these is missing, the form is hidden instead of pretending to send.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Address that receives the proposals.
CONTACT_TO=
# Optional sender address (defaults to SMTP_USER).
CONTACT_FROM=

# ── Donations (only configured channels are shown) ──────────
# e.g. https://paypal.me/your-name
NEXT_PUBLIC_DONATE_PAYPAL=
# e.g. https://ko-fi.com/your-name
NEXT_PUBLIC_DONATE_KOFI=
# Bizum phone number or NGO code, shown with a copy button.
NEXT_PUBLIC_DONATE_BIZUM=

# ── Data pipeline ────────────────────────────────────────────
# Contact included in the User-Agent of every outgoing request (required by
# Wikimedia's User-Agent policy). Use an address or URL where you can be reached.
DATA_CONTACT=
